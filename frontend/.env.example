# Public API base used by the browser client.
# Example (single-domain reverse proxy):
# NEXT_PUBLIC_API_BASE=https://odr.zlyxy.me/api
#
# Example (frontend + api on different hosts):
# NEXT_PUBLIC_API_BASE=https://api.odr.zlyxy.me/api
NEXT_PUBLIC_API_BASE=
# Optional server-side rewrite target when different from NEXT_PUBLIC_API_BASE
NEXT_SERVER_API_BASE=
# Comma-separated dev origins for Next.js reverse-proxy/dev warnings
ALLOWED_DEV_ORIGINS=
