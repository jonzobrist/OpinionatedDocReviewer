{
  "name": "opinionated-doc-reviewer-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'next dev -p \"${PORT:-3000}\"'",
    "build": "next build",
    "start": "sh -c 'next start -p \"${PORT:-3000}\"'",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node ./scripts/smoke-nav.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "mermaid": "~11.16.1",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "jsdom": "24.0.0",
    "playwright": "^1.58.2",
    "typescript": "5.4.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "lodash-es": "^4.18.1",
    "picomatch": "^4.0.4",
    "sharp": "^0.35.4",
    "postcss": "^8.5.23",
    "vite": "^7.3.5",
    "esbuild": "^0.28.1",
    "mermaid": {
      "katex": "0.18.2",
      "uuid": "^11.1.1"
    }
  }
}
